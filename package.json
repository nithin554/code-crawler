{
  "name": "@nithin554/code-crawler",
  "version": "0.1.0",
  "mcpName": "io.github.nithin554/code-crawler",
  "description": "Static and dynamic call tracing MCP server backed by a SQLite property graph of your codebase",
  "type": "module",
  "license": "MIT",
  "homepage": "https://nithin554.github.io/code-crawler/",
  "bugs": {
    "url": "https://github.com/nithin554/code-crawler/issues"
  },
  "bin": {
    "codecrawler": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nithin554/code-crawler.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bench.json",
    "bench": "tsx bench/run.ts",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "ignore": "^7.0.14",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
